{
  "name": "picklematch-vn",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web --output-dir web-build",
    "pretest:e2e:web": "playwright install",
    "test:e2e:web": "playwright test",
    "test:e2e:web:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test": "jest",
    "test:domain": "tsx tests/domain-logic.test.mts",
    "test:suggester": "jest tests/next-round-suggester",
    "test:suggester:unit": "jest tests/next-round-suggester/unit",
    "test:suggester:property": "jest tests/next-round-suggester/property",
    "test:suggester:scenario": "jest tests/next-round-suggester/scenario",
    "test:suggester:simulation": "jest tests/next-round-suggester/simulation",
    "test:suggester:fairness": "jest tests/next-round-suggester/fairness",
    "sim": "jest tests/next-round-suggester/simulation/sanity.test.ts tests/next-round-suggester/simulation/targets.test.ts",
    "diagnose": "npx tsx scripts/diagnose-session.ts",
    "sim:plan": "npx tsx scripts/sim-planning-vs-greedy.ts",
    "sim:sanity": "jest tests/next-round-suggester/simulation/sanity.test.ts",
    "sim:targets": "jest tests/next-round-suggester/simulation/targets.test.ts",
    "sim:ab": "jest tests/next-round-suggester/simulation/ab-comparison.test.ts --testTimeout=900000",
    "sim:stress": "jest tests/next-round-suggester/simulation/stress.test.ts --testTimeout=600000",
    "sim:full": "npm run sim:sanity && npm run sim:targets && npm run sim:ab && npm run sim:stress",
    "sim:report": "tsx scripts/run-simulation-report.ts",
    "bench:live-session": "tsx scratch/bench-live-session-flow.ts",
    "bench:v2-full-flow": "tsx scratch/bench-v2-full-flow.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:baseline": "node ./scripts/typecheck-baseline.mjs",
    "typecheck:guard": "node ./scripts/typecheck-baseline.mjs --check",
    "verify:typecheck-fix": "npm run typecheck:guard && npm run check:encoding && git diff --check && npm run build:web",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:errors": "eslint . --ext .ts,.tsx,.js,.jsx --quiet",
    "lint:warnings:report": "eslint . --ext .ts,.tsx,.js,.jsx -f json -o .lint-report.json && node ./scripts/lint-warnings-report.mjs",
    "check:encoding": "node ./scripts/check-encoding.mjs",
    "check:secrets": "node ./scripts/check-secrets.mjs",
    "seed:dummy": "node --env-file=.env.server ./scripts/seed-dummy-data.mjs",
    "smoke:backend": "node --env-file=.env.server ./scripts/smoke-backend.mjs",
    "test:security": "tsx tests/security.test.mts",
    "test:ui": "jest",
    "validate:scheduler": "node scripts/validate-round-robin-scheduler.cjs",
    "validate:scheduler:full": "node scripts/validate-round-robin-scheduler.cjs --full",
    "check:artifacts": "node ./scripts/check-temp-artifacts.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.2.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/webpack-config": "^19.0.0",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-native-community/datetimepicker": "7.2.0",
    "@react-native-community/slider": "4.4.2",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/elements": "^1.3.18",
    "@react-navigation/native": "^6.1.7",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.100.14",
    "date-fns": "^4.1.0",
    "expo": "^49.0.23",
    "expo-blur": "~12.4.1",
    "expo-constants": "~14.4.2",
    "expo-device": "~5.4.0",
    "expo-font": "~11.4.0",
    "expo-haptics": "~12.4.0",
    "expo-image": "~1.3.5",
    "expo-linear-gradient": "~12.3.0",
    "expo-linking": "~5.0.2",
    "expo-location": "~16.1.0",
    "expo-notifications": "~0.20.1",
    "expo-router": "^2.0.0",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~2.4.0",
    "expo-web-browser": "~12.3.2",
    "i18next": "^26.3.0",
    "lucide-react-native": "^0.281.0",
    "nativewind": "^2.0.11",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.72.10",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-reanimated": "~3.3.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.6",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/react-native": "^13.0.1",
    "@types/react": "~18.2.14",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~49.0.0",
    "react-test-renderer": "18.2.0",
    "seedrandom": "^3.0.5",
    "supabase": "^2.98.2",
    "tsx": "^4.22.0",
    "typescript": "~5.1.3"
  },
  "private": true
}
